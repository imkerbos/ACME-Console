# =============================================================================
# ACME Console — Production Environment Variables
# =============================================================================
# cp deploy/.env.example deploy/.env && vim deploy/.env
# 然后 make prod-docker-up-d 即可。

# --- MySQL -------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=acme_console
MYSQL_USER=acme
MYSQL_PASSWORD=change_me

# --- Ports (宿主机端口映射) ---------------------------------------------------
MYSQL_PORT=3306
API_PORT=10020
HTTP_PORT=80
HTTPS_PORT=443

# --- App Secrets -------------------------------------------------------------
# 留空则启动时自动生成，也可以手动指定: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_MASTER_KEY=

# --- HTTPS / Domain ----------------------------------------------------------
# 留空则用自签名证书 + IP 访问（浏览器会提示不安全，忽略即可）
# 填了域名并替换 deploy/certs/ 下的证书文件，即用你自己的证书
SERVER_NAME=

# HTTP 是否 301 跳转到 HTTPS（true / false）
REDIRECT_HTTP_TO_HTTPS=true
